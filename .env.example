# pdf-markdown environment configuration
# Copy this file to .env and fill in any values you want to override.
# Environment variables always take priority over values set here.
# The .env file itself is gitignored — this file (.env.example) is safe to commit.

# ── Output paths ─────────────────────────────────────────────────────────────

# Root directory where run logs and HTML reports are stored.
# Each run creates: <data_dir>/<log_subdir>/<run_name>/output.log
#                                                      report.html
PDF_MARKDOWN_DATA_DIR=./data

# Sub-directory name under data_dir that holds per-run folders.
PDF_MARKDOWN_LOG_SUBDIR=runs

# ── Reports ───────────────────────────────────────────────────────────────────

# Title shown in the browser tab and <h1> of generated HTML reports.
PDF_MARKDOWN_REPORT_TITLE=PDF Conversion Report

# Set to "true" to automatically open the report in your default browser
# immediately after a conversion run or 'pdf-markdown report' command.
PDF_MARKDOWN_OPEN_REPORT=false

# ── Conversion ────────────────────────────────────────────────────────────────

# Number of parallel workers for PDF conversion. Default 1 (sequential).
# Increase for faster batch processing when you have sufficient RAM/VRAM.
PDF_MARKDOWN_WORKERS=1

# Path to HuggingFace model cache (HF_HOME). When set, Marker downloads/loads
# models from this directory. Leave empty to use the default (~/.cache/huggingface).
PDF_MARKDOWN_MODEL_PATH=

# Converter backend: "marker" (default, ML-powered) or "pymupdf4llm" (lightweight).
# For pymupdf4llm, install with: pip install pdf-markdown[light]
PDF_MARKDOWN_CONVERTER=marker

# ── Test data (generate_shakespeare_pdfs.py) ───────────────────────────────────

# Root directory for generated test PDFs. Script outputs to <dir>/shakespeare/.
# Default: ../testData (sibling of repo root)
TEST_DATA_DIR=../testData
