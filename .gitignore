# Files and directories generated by Python, tools, and macOS
# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# ── Tools ─────────────────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/

# ── Generated output / data ───────────────────────────────────────────────────
# Converted Markdown output (not committed — large and user-specific)
transformed/

# Run logs and HTML reports
data/

# Extracted images from fallback conversion
*_assets/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
# .env.example is intentionally committed (no secrets, just keys)

# ── Editors and OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
output/
pytest-of-*/